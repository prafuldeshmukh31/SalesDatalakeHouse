    {
      "name": "gold_customers",
      "displayName": "Gold Customer Enriched",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  customer_key,\n",
        "  first_name,\n",
        "  last_name,\n",
        "  marital_status,\n",
        "  gender,\n",
        "  birth_date,\n",
        "  country,\n",
        "  created_date\n",
